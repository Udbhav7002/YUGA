GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_fine_grained_pat_here
GITHUB_REPO=yourusername/codeghost-demo

# GitHub OAuth app (for user login on /login — create at
# github.com/settings/developers, callback: http://<host>:<port>/auth/callback)
GITHUB_OAUTH_CLIENT_ID=your_oauth_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# Shared secret for HMAC signing between target app and orchestrator
CODEGHOST_SHARED_SECRET=doomsday-hackathon-secret-2026

# The orchestrator uses this to know where to read the source files
TARGET_SOURCE_DIR=/app/target-src

# Docker sandbox settings
SANDBOX_IMAGE=codeghost-sandbox:latest
MAX_FIX_ATTEMPTS=2
PIPELINE_DEADLINE=300
